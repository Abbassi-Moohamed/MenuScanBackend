# ============================================================
# MENU SCAN backend — environment variables
# Duplicate this file as `.env` and fill in your real values.
# Never commit the real `.env` file.
# ============================================================

# Node environment: development | test | production
NODE_ENV=development

# Host/port the API listens on
HOST=0.0.0.0
PORT=4000

# MongoDB connection string.
# Local (no auth):
#   mongodb://127.0.0.1:27017/menuscan
# MongoDB Atlas / remote (always include credentials + authSource):
#   mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/menuscan?retryWrites=true&w=majority
DATABASE_URL=mongodb://127.0.0.1:27017/menuscan

# The Next.js frontend origin the API is allowed to serve.
# This is the primary CORS origin. Keep it exact (scheme + host + port).
FRONTEND_URL=http://localhost:3000

# Optional: additional allowed origins, comma-separated.
# Example: https://menuscan.vercel.app,http://localhost:3001
# Use "*" to allow any origin — development only; rejected in production.
CORS_ORIGINS=

# Pino log level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# ---- Backoffice (MVP) ----
# Static 4-digit PIN for the MENU SCAN application admin (menuscan/admin screen).
# Yes, hardcoding a PIN is a deliberate MVP shortcut — this is a gate, not an
# auth system. Replace it with real authentication before going to production.
APP_ADMIN_PIN=3219

# Secret used to sign the short-lived admin bearer tokens (HS256).
# MUST be a long random value in production; the default dev value is refused
# when NODE_ENV=production. Example generation: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=change-me-to-a-long-random-string

# Admin bearer token lifetime, in jsonwebtoken notation (e.g. "12h", "1d").
ADMIN_TOKEN_TTL=12h